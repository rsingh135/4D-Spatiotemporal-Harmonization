# Python
__pycache__/
*.pyc
.venv/
venv/

# Jupyter
.ipynb_checkpoints/

# OS / editor
.DS_Store
.vscode/

# Large / generated artifacts (adjust as needed)
output/
outputs/
point_cloud/
point_clouds/
*.pt
*.pth
*.ckpt
*.mp4
